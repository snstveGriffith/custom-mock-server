[
  {
    "id": "list-users",
    "method": "GET",
    "path": "/api/users",
    "status": 200,
    "delayMs": 500,
    "headers": { "X-Mock": "true" },
    "body": [
      { "id": 1, "name": "Ana" },
      { "id": 2, "name": "Bruno" }
    ]
  },
  {
    "id": "get-user",
    "method": "GET",
    "path": "/api/users/{id}",
    "status": 200,
    "delayMs": 200,
    "body": { "id": 1, "name": "Ana", "email": "ana@exemplo.com" }
  },
  {
    "id": "create-user",
    "method": "POST",
    "path": "/api/users",
    "status": 201,
    "body": { "message": "Usuário criado com sucesso" }
  },
  {
    "id": "simulated-failure",
    "method": "*",
    "path": "/api/error/**",
    "status": 500,
    "delayMs": 1500,
    "body": { "error": "Falha simulada pelo mock server" }
  }
]